    {
      "name": "key-order-array-index",
      "note": "ARRAY-INDEX KEYS SORT NUMERICALLY, NOT LEXICOGRAPHICALLY. A naive \"sort all keys as strings\" implementation produces {\"1\":3,\"10\":1,\"2\":2} and a different hash. See SPEC.md §4.2.2.",
      "inputJson": "{\"10\":1,\"2\":2,\"1\":3}",
      "canonical": "{\"1\":3,\"2\":2,\"10\":1}",
      "sha256": "e0c78ab1e9ce6019cfb6433b1bc900cf402e3965602bb947f54031cb16a659fa"
    },
    {
      "name": "key-order-index-vs-string",
      "note": "Array-index keys (2, 10, 4294967294) come FIRST in numeric order; everything else — including \"01\", \"-1\", \"1.5\" and 4294967295 (= 2**32-1, deliberately NOT an index) — follows in UTF-16 order.",
      "inputJson": "{\"b\":1,\"10\":2,\"a\":3,\"2\":4,\"01\":5,\"-1\":6,\"1.5\":7,\"4294967295\":8,\"4294967294\":9}",
      "canonical": "{\"2\":4,\"10\":2,\"4294967294\":9,\"-1\":6,\"01\":5,\"1.5\":7,\"4294967295\":8,\"a\":3,\"b\":1}",
      "sha256": "21decc137e246e34f0d1dda92e9826158295eb129f971286c19adaf351526970"
    },
    {
      "name": "key-order-big-numeric",
